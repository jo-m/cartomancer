#!/usr/bin/env bash
# Reject pushes that include fixup! or squash! commits.
# Exception: ebc27368dc4c7df53c3297362ea8047197a66f43 is grandfathered.

EXEMPT="ebc27368dc4c7df53c3297362ea8047197a66f43"
ZERO="0000000000000000000000000000000000000000"

found=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # Skip branch deletions.
    [ "$local_sha" = "$ZERO" ] && continue

    if [ "$remote_sha" = "$ZERO" ]; then
        range="$local_sha"
    else
        range="$remote_sha..$local_sha"
    fi

    while IFS=" " read -r sha subject; do
        [ "$sha" = "$EXEMPT" ] && continue
        if [[ "$subject" == "fixup! "* || "$subject" == "squash! "* ]]; then
            echo "error: fixup commit found: $sha $subject" >&2
            found=1
        fi
    done < <(git log --format="%H %s" "$range")
done

exit $found
