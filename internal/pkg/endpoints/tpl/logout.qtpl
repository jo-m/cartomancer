{% code
type LogoutPage struct {
	BasePage
}

// Compile time interface check.
var _ Page = (*LogoutPage)(nil)
%}

{% func (p *LogoutPage) Title() %}
	Logout
{% endfunc %}

{% func (p *LogoutPage) Body() %}
	<h1>{%s p.Title() %}</h1>
	<div>
		<form action="" method="POST">
			<button type="submit">Logout</button>
		</form>
	</div>
{% endfunc %}
