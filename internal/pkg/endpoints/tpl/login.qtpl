{% import "goweb/internal/pkg/oapi" %}
{% code
type LoginPage struct {
	BasePage
    Message string
    LoginData oapi.Login
}

// Compile time interface check.
var _ Page = (*LoginPage)(nil)
%}

{% func (p *LoginPage) Title() %}
	Login
{% endfunc %}

{% func (p *LoginPage) Body() %}
	<h1>{%s p.Title() %}</h1>
	<div>
        {%s p.Message %}
        <form action="" method="POST">
            <label for="email">Email:</label>
            <input type="email" id="email" name="email" required value="{%s p.LoginData.Email %}">

            <label for="password">Password:</label>
            <input type="password" id="password" name="password" required value="{%s p.LoginData.Password %}">

            <button type="submit">Login</button>
        </form>
	</div>
{% endfunc %}
