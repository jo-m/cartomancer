{%
interface Page {
	Title()
	Body()
}
%}

{% func PageTemplate(p Page) %}
<!DOCTYPE html>
<html>
	<head>
		<meta charset="utf-8">
		<title>{%= p.Title() %}</title>
	</head>
	<body>
		<nav>
			<h1>Navigation</h1>
			<ol>
			  <li><a href="/">return to main page</a></li>
			  <li><a href="/api/v1/sessions/logout">logout</a></li>
			  <li><a href="/api/v1/sessions/login">login</a></li>
			</ol>
		  </nav>
		<div>
		<main>
			{%= p.Body() %}
		</main>
	</body>
</html>
{% endfunc %}

{% code type BasePage struct {
	CurrentUserName string
} %}

{% func (p *BasePage) Title() %}
This is the base title
{% endfunc %}

{% func (p *BasePage) Body() %}
This is the base body
{% endfunc %}
