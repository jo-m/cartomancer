{% import "goweb/internal/pkg/db" %}
{%
interface Page {
	Title()
	UserInfo()
	Body()
}
%}

{% func PageTemplate(p Page) %}
<!DOCTYPE html>
<html>
	<head>
		<meta charset="utf-8">
		<title>{%= p.Title() %}</title>
	</head>
	<body>
		<nav>
			<h1>Navigation</h1>
			<ol>
				<!-- TODO: Get URLs from OpenAPI spec. -->
				<li><a href="/">Main page</a></li>
				{%= p.UserInfo() %}
			</ol>
		</nav>
		<main>
			{%= p.Body() %}
		</main>
	</body>
</html>
{% endfunc %}

{% code type BasePage struct {
	User *db.User
} %}

{% func (p *BasePage) Title() %}
	{% code panic("not implemented") %}
{% endfunc %}

{% func (p *BasePage) UserInfo() %}
	{% if p.User != nil %}
		<li>Logged in as: {%s p.User.Email %}</li>
		<li><a href="/sessions/logout">logout</a></li>
	{% else %}
		<li><a href="/sessions/login">login</a></li>
	{% endif %}
{% endfunc %}

{% func (p *BasePage) Body() %}
	{% code panic("not implemented") %}
{% endfunc %}
