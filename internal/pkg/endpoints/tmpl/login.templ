package tmpl

import "github.com/jo-m/goweb/internal/pkg/oapi"

templ LoginPage(d PageData, message string, loginData oapi.Login) {
	@PageTemplate(d, "Login") {
		<div>
			{ message }
			<form action={ d.L.PostSessionsLogin() } method="POST">
				<label for="email">Email:</label>
				<input type="email" id="email" name="email" required value={ loginData.Email }/>
				<label for="password">Password:</label>
				<input type="password" id="password" name="password" required value={ loginData.Password }/>
				<button type="submit">Login</button>
			</form>
		</div>
	}
}
