package tmpl

import (
	"context"

	"goweb/internal/pkg/db"
	"goweb/internal/pkg/oapi"
	"goweb/internal/pkg/session"
)

type PageContext struct {
	User *db.User
	L    oapi.Links
}

func GetPageContext(ctx context.Context) PageContext {
	return PageContext{
		User: session.GetUser(ctx),
		L:    *oapi.MustGetLinks(ctx),
	}
}

templ PageTemplate(p PageContext, title string) {
	<!DOCTYPE html>
	<html>
		<head>
			<meta charset="utf-8"/>
			<title>{ title }</title>
		</head>
		<body>
			<nav>
				<h1>Navigation</h1>
				<ul>
					<li><a href={ S(p.L.Get()) }>Main page</a></li>
					@userInfo(p)
				</ul>
			</nav>
			<main>
				{ children... }
			</main>
		</body>
	</html>
}

templ userInfo(p PageContext) {
	if p.User != nil {
		<li>Logged in as: { p.User.Email }</li>
		<li><a href={ S(p.L.GetSessionsLogout()) }>logout</a></li>
	} else {
		<li><a href={ S(p.L.GetSessionsLogin()) }>login</a></li>
	}
}
