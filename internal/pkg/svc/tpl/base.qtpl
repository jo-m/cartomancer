{%
interface Page {
	Title()
	Body()
	UserName()
}
%}

{% func PageTemplate(p Page) %}
<!DOCTYPE html>
<html>
	<head>
		<meta charset="utf-8">
		<title>{%= p.Title() %}</title>
	</head>
	<body>
		<div>
			<a href="/">return to main page</a>
			<a href="/api/v1/sessions/logout">logout</a>
			<a href="/api/v1/sessions/login">login</a>
			{%s p.UserName() %}	
		</div>
		{%= p.Body() %}
	</body>
</html>
{% endfunc %}

{% code type BasePage struct {
	CurrentUserName string
} %}

{% func (p *BasePage) Title() %}
This is the base title
{% endfunc %}

{% func (p *BasePage) Body() %}
This is the base body
{% endfunc %}

{% func (p *BasePage) UserName() %}
{%s p.CurrentUserName %}
{% endfunc %}
