{%
interface Page {
	Title()
	Body()
}
%}

{% func PageTemplate(p Page) %}
<!DOCTYPE html>
<html>
	<head>
		<meta charset="utf-8">
		<title>{%= p.Title() %}</title>
	</head>
	<body>
		<div>
			<a href="/">return to main page</a>
		</div>
		{%= p.Body() %}
	</body>
</html>
{% endfunc %}

{% code type BasePage struct {} %}
{% func (p *BasePage) Title() %}
This is the base title
{% endfunc %}

{% func (p *BasePage) Body() %}
This is the base body
{% endfunc %}
