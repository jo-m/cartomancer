strict_env

# This file contains only a minimal set of options, for development.
# Run the binary with --help to show all available.

# Goose CLI tools (needed for db migrations in development only).
export GOOSE_DRIVER=sqlite3
export GOOSE_DBSTRING="$(expand_path data/db.sqlite)"
export GOOSE_MIGRATION_DIR="$(expand_path internal/pkg/db/migrations/)"

# App config
export APP_DEV_MODE=true
export APP_EXTERNAL_BASE_URL="http://localhost:5173"
export APP_EMAIL_JWT_SECRET=supersecret_supersecret_supersecret_supersecret$
export APP_REGISTRATION_ENABLED=true

# Logging
export LOG_PRETTY=true
export LOG_LEVEL=DEBUG

# Jobs
export JOBS_MAX_PARALLEL=2

# Sessions
export SESSION_JWT_SECRET=supersecret_supersecret_supersecret_supersecret!

# Email
export MAIL_SMTP_HOST=localhost
export MAIL_SMTP_PORT=1025
export MAIL_SMTP_NO_TLS=true
export MAIL_FROM=admin@example.org
