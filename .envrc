strict_env

# For the goose CLI tools.
export GOOSE_DRIVER=sqlite3
export GOOSE_DBSTRING="$(expand_path data/db.sqlite)"
export GOOSE_MIGRATION_DIR="$(expand_path internal/pkg/db/migrations/)"

export LOG_PRETTY=true
export LOG_LEVEL=DEBUG

# Comment this out to enable autocleanup
export JOBS_AUTO_CLEANUP_PERIOD=1m
export JOBS_MAX_PARALLEL=2
export JOBS_AUTO_CLEANUP_MIN_AGE=5m

export SESSION_IDLE_TIMEOUT=30m
export SESSION_ABS_TIMEOUT=24h
export SESSION_COOKIE_NAME=sid
export SESSION_COOKIE_PATH=/
export SESSION_JWT_SECRET=supersecret_supersecret_supersecret_supersecret!

export MAIL_SMTP_HOST=localhost
export MAIL_SMTP_PORT=1025
export MAIL_SMTP_NO_TLS=true
export MAIL_FROM=admin@example.org

export APP_NAME="Detour"
export EXTERNAL_BASE_URL="http://localhost:5173"
export EMAIL_JWT_SECRET=supersecret_supersecret_supersecret_supersecret$
export TRACK_COLOR='#cf5e29'
